#!/bin/bash
# dsh-web-launcher —— dsh web 的 systemd 前端包装器
#
# 解决两个 dsh 原生没有的能力：
#   1) 端口避让：dsh 自己的 --port 0 是"让 OS 随机挑一个"，端口每次都变；
#      这里要的是"固定 3080，被占了才往后找"，这样浏览器书签和端口转发规则才稳定。
#   2) token URL 落盘：dsh 只在启动时把带 token 的地址打印一次到 stdout，
#      systemd 环境下 stdout 进 journal，人得自己翻。这里抓下来存成文件。
#
# 环境变量（都由 install.sh 写进 unit 的 Environment=）：
#   DSH_BIN            dsh 可执行文件绝对路径（必填，否则回退到 PATH 查找）
#   DSH_WEB_BASE_PORT  起始端口，默认 3080
#   DSH_WEB_PORT_TRIES 最多往后找几个端口，默认 20
#   DSH_WEB_URL_FILE   token URL 落盘位置，默认 ~/.local/state/dsh-web/url.txt
set -uo pipefail

DSH_BIN="${DSH_BIN:-$(command -v dsh 2>/dev/null || true)}"
BASE_PORT="${DSH_WEB_BASE_PORT:-3080}"
PORT_TRIES="${DSH_WEB_PORT_TRIES:-20}"
URL_FILE="${DSH_WEB_URL_FILE:-$HOME/.local/state/dsh-web/url.txt}"

if [ -z "$DSH_BIN" ] || [ ! -x "$DSH_BIN" ]; then
  echo "dsh-web-launcher: 找不到可执行的 dsh（DSH_BIN=$DSH_BIN）" >&2
  echo "  用 'command -v dsh' 确认路径，或在 unit 里设置 Environment=DSH_BIN=..." >&2
  exit 1
fi

mkdir -p "$(dirname "$URL_FILE")" || exit 1

# ---- 端口探测 ----
# 用 grep -c 而不是 grep -q：grep -q 命中即退出会让上游 ss 收到 SIGPIPE，
# set -o pipefail 下整条管道被判失败，于是"端口被占"被误判成"端口空闲"，
# 然后 dsh 以 EADDRINUSE 崩掉。grep -c 读完整个输入，没有这个竞态。
port_in_use() {
  local n
  if command -v ss >/dev/null 2>&1; then
    n=$(ss -H -ltn "sport = :$1" 2>/dev/null | grep -c . || true)
    [ "${n:-0}" -gt 0 ]
  else
    # 没有 ss 时退回 bash 的 /dev/tcp：连得上说明有人在听
    (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null && { exec 3<&- 3>&-; return 0; }
    return 1
  fi
}

port="$BASE_PORT"
tried=0
while port_in_use "$port"; do
  port=$((port + 1))
  tried=$((tried + 1))
  if [ "$tried" -ge "$PORT_TRIES" ]; then
    echo "dsh-web-launcher: $BASE_PORT..$((BASE_PORT + PORT_TRIES - 1)) 全被占用" >&2
    exit 1
  fi
done
[ "$port" -ne "$BASE_PORT" ] && echo "dsh-web-launcher: 端口 $BASE_PORT 被占用，改用 $port"

OUT_FILE=$(mktemp "${TMPDIR:-/tmp}/dsh-web-out.XXXXXX") || exit 1
child=""
watcher=""

# 服务停掉后把 url 文件标成失效，免得下一个人拿着过期 token 排查半天
invalidate_url() {
  [ -f "$URL_FILE" ] && \
    echo "# STOPPED at $(date -Is) — token 已失效，重启服务后需重新取" > "$URL_FILE"
  return 0
}

cleanup() {
  [ -n "$watcher" ] && kill "$watcher" 2>/dev/null
  rm -f "$OUT_FILE"
  invalidate_url
}

# unit 里是 KillMode=mixed：SIGTERM 只发给 MainPID（也就是本脚本），
# 不转发的话 systemd 等满 TimeoutStopSec 再 SIGKILL，会留下孤儿 node 进程。
shutdown() {
  if [ -n "$child" ] && kill -0 "$child" 2>/dev/null; then
    kill -TERM "$child" 2>/dev/null
    for _ in $(seq 1 150); do   # 15s，与 unit 的 TimeoutStopSec=20 对齐
      kill -0 "$child" 2>/dev/null || break
      sleep 0.1
    done
    kill -KILL "$child" 2>/dev/null
    wait "$child" 2>/dev/null
  fi
  cleanup
  exit 0
}
trap shutdown TERM INT

"$DSH_BIN" web --no-open --host 127.0.0.1 --port "$port" \
  --trusted-host 127.0.0.1 --trusted-host localhost \
  > >(tee -a "$OUT_FILE") 2>&1 &
child=$!

(
  while true; do
    url=$(grep -aoE 'https?://[^ '"'"'"]*token=[A-Za-z0-9._-]+' "$OUT_FILE" 2>/dev/null | head -1)
    if [ -n "$url" ]; then
      { echo "# generated $(date -Is) by dsh-web-launcher on port $port"; echo "$url"; } \
        > "$URL_FILE.tmp" && mv "$URL_FILE.tmp" "$URL_FILE" && chmod 600 "$URL_FILE"
      exit 0
    fi
    sleep 0.3
  done
) &
watcher=$!

wait "$child"
rc=$?
cleanup
exit "$rc"
